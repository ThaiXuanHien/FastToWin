FROM grafana/alloy@sha256:491b0578c04983fd54fe99b587b6fab4404dc46d0dc16677bd6b00cc1140b308 AS alloy
FROM gcr.io/distroless/static-debian13@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329 AS ca
FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
COPY --from=alloy /bin/alloy /bin/alloy
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0444 deploy/monitoring/redis-monitor-cloud/prepare.mjs deploy/monitoring/redis-monitor-cloud/prepare-runtime.mjs /opt/redis-monitor-cloud/
COPY --chmod=0555 deploy/monitoring/redis-monitor-cloud/sender-entrypoint.sh /opt/redis-monitor-cloud/sender-entrypoint.sh
RUN test -s /etc/ssl/certs/ca-certificates.crt && chmod 0555 /opt/redis-monitor-cloud && mkdir -p /var/lib/alloy && chown 65532:65532 /run /var/lib/alloy && chmod 0700 /run /var/lib/alloy
COPY --chmod=0444 deploy/monitoring/redis-monitor-cloud/runtime-directory.mjs /opt/redis-monitor-cloud/runtime-directory.mjs
USER 65532:65532
ENTRYPOINT ["/bin/sh", "/opt/redis-monitor-cloud/sender-entrypoint.sh"]
