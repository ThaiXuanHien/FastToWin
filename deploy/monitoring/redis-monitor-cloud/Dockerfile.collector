# The image is packaging only; build with a previously verified frozen collector
# binary at build-context /redis-monitor. It does not compile/change the collector.
FROM gcr.io/distroless/static-debian13@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329 AS ca
FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0555 redis-monitor /usr/local/bin/redis-monitor
COPY --chmod=0555 deploy/monitoring/redis-monitor-cloud/collector-entrypoint.sh /opt/redis-monitor-cloud/collector-entrypoint.sh
RUN test -s /etc/ssl/certs/ca-certificates.crt && chown 65532:65532 /run && chmod 0700 /run
COPY --chmod=0444 deploy/monitoring/redis-monitor-cloud/runtime-directory.mjs /opt/redis-monitor-cloud/runtime-directory.mjs
USER 65532:65532
ENTRYPOINT ["/bin/sh", "/opt/redis-monitor-cloud/collector-entrypoint.sh"]
