# Chỉ ghi cấu hình không bí mật ở đây. Không thêm mật khẩu hay private key.
FASTTOWIN_DOMAIN=play.your-domain.com
ACME_EMAIL=admin@your-domain.com
# Tùy chọn: đổi prefix image nếu máy chủ dùng chung Docker với project khác.
FASTTOWIN_SERVER_IMAGE=fasttowin-server
FASTTOWIN_WEB_IMAGE=fasttowin-web
GRAFANA_ADMIN_USER=admin

POSTGRES_DB=fasttowin
POSTGRES_USER=fasttowin_app
DATABASE_POOL_SIZE=10
FASTTOWIN_BACKUP_RETENTION_DAYS=14

FASTTOWIN_SMTP_HOST=smtp.your-provider.com
FASTTOWIN_SMTP_PORT=587
FASTTOWIN_SMTP_USERNAME=no-reply@your-domain.com
FASTTOWIN_SMTP_FROM_EMAIL=no-reply@your-domain.com
FASTTOWIN_SMTP_FROM_NAME=Fast To Win
FASTTOWIN_SMTP_STARTTLS=true
FASTTOWIN_SMTP_SSL=false

FASTTOWIN_PUSH_ZONE=Asia/Ho_Chi_Minh
FASTTOWIN_DAILY_PUSH_HOUR=19
FASTTOWIN_MAINTENANCE=false
FASTTOWIN_MAINTENANCE_MESSAGE=Máy chủ đang bảo trì. Vui lòng quay lại sau.
