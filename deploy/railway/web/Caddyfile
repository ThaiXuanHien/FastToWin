{
	admin off
	auto_https off
	# SEC-01: only proxies inside these ranges may supply the client IP header.
	# Railway's edge reaches this service over its private network; when Cloudflare
	# is in front, set FASTTOWIN_CLIENT_IP_HEADERS=CF-Connecting-IP (see
	# docs/infrastructure-runbook.md). An untrusted peer falls back to its own address.
	servers {
		trusted_proxies static {$FASTTOWIN_TRUSTED_PROXIES:private_ranges 100.64.0.0/10}
		client_ip_headers {$FASTTOWIN_CLIENT_IP_HEADERS:X-Real-IP X-Forwarded-For}
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	encode zstd gzip

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	@backend path /game /auth/* /api/* /status /health /admin /admin/* /gifts/mailbox /gifts/mailbox/*
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM} {
			# This service is reached only through Railway's HTTPS edge.
			header_up X-Forwarded-Proto https
			# The backend keys rate limits on the first X-Forwarded-For value, so it
			# must be exactly the resolved client IP and never a client-supplied chain.
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
		}
	}

	# Legal documents must never fall through to the game SPA.
	@legal path_regexp legal ^/(privacy|delete-account|terms)(/en)?/?$
	handle @legal {
		root * /srv
		rewrite * /legal/{re.legal.1}{re.legal.2}/index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Seller declarations must never fall through to the game SPA.
	handle /app-ads.txt {
		root * /srv
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@runtime path / /index.html /config.js /service-worker.js
	header @runtime Cache-Control "no-store"
	# SEC-07: Cloudflare Turnstile loads its script and challenge iframe from challenges.cloudflare.com.
	@gameCsp {
		not path /admin /admin/*
	}
	header @gameCsp Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com https://challenges.cloudflare.com 'wasm-unsafe-eval'; connect-src 'self' https://*.googleapis.com https://*.google.com https://challenges.cloudflare.com wss:; frame-src https://challenges.cloudflare.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
