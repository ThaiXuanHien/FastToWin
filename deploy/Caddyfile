{
	email {$ACME_EMAIL}
}

{$FASTTOWIN_DOMAIN} {
	encode zstd gzip

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	@backend path /game /auth/* /api/* /status /health /admin /admin/* /gifts/mailbox /gifts/mailbox/*
	handle @backend {
		reverse_proxy server:8080
	}

	# Public legal documents bypass the game SPA.
	@legal path_regexp legal ^/(privacy|delete-account|terms)(/en)?/?$
	handle @legal {
		root * /srv
		rewrite * /legal/{re.legal.1}{re.legal.2}/index.html
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@runtime path / /index.html /config.js /service-worker.js
	header @runtime Cache-Control "no-store"
	@gameCsp {
		not path /admin /admin/*
	}
	header @gameCsp Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com 'wasm-unsafe-eval'; connect-src 'self' https://*.googleapis.com https://*.google.com wss:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
