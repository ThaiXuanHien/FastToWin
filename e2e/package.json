{
  "name": "fast-to-win-web-e2e",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:responsive": "playwright test --project=chromium-small-phone --project=chromium-large-phone --project=chromium-tablet --project=chromium-landscape --project=chromium-adaptive-input",
    "test:cross-browser": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:js-fallback": "node support/test-js-fallback.mjs",
    "test:all": "playwright test",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "serve": "node support/serve.mjs"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
